# Copy this file to .env and fill in what you have. Everything is optional.
# Jarvis works with NO keys at all (offline command mode). Add ONE free key to enable conversation.

# ---- Brain -------------------------------------------------------------
# auto | groq | gemini | ollama | offline   (auto = first one that works, in that order)
JARVIS_PROVIDER=auto

# Groq — free tier, no card. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier, no card. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama — 100% local & free. Install from https://ollama.com then `ollama pull llama3.2`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Personality -------------------------------------------------------
JARVIS_NAME=Jarvis
JARVIS_USER=sir
JARVIS_WAKE_WORD=jarvis

# ---- Location (for weather & news; keyless public APIs) ---------------
JARVIS_CITY=                # default city for "weather" (or say: remember my city is Pune)
JARVIS_COUNTRY=IN           # news region: IN, US, GB, AU, ...

# ---- Behaviour ---------------------------------------------------------
JARVIS_VOICE=false        # start in voice mode by default (or pass --voice)
JARVIS_TTS=true           # speak replies out loud (needs pyttsx3)
JARVIS_CONFIRM=true       # ask before risky actions (close app, lock screen)
JARVIS_SEARCH=duckduckgo  # duckduckgo | google | bing | brave
JARVIS_TIMEOUT=30         # seconds per API call
